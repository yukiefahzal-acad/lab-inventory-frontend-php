				{
					"name": "Riwayat Peminjaman",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/peminjaman/riwayat?search=mikroskop&user_id=1",
							"host": ["{{base_url}}"],
							"path": ["api", "peminjaman", "riwayat"],
							"query": [
								{
									"key": "search",
									"value": "mikroskop",
									"description": "Pencarian berdasarkan nama alat atau detail peminjaman"
								},
								{
									"key": "user_id",
									"value": "1",
									"description": "Filter berdasarkan user ID (hanya untuk Admin)"
								}
							]
						},
						"description": "Mengambil riwayat peminjaman. Jika role bukan Admin, hanya menampilkan riwayat user yang sedang login."
					},
					"response": []
				},
				{
					"name": "Persetujuan Peminjaman (Disetujui)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": 1,\n    \"status\": \"Disetujui\",\n    \"catatan_pinjaman\": \"Disetujui oleh admin. Harap dijaga dengan baik.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/peminjaman/persetujuan",
							"host": ["{{base_url}}"],
							"path": ["api", "peminjaman", "persetujuan"]
						},
						"description": "Menyetujui peminjaman. Membutuhkan role Admin. Status hanya bisa diubah dari 'Menunggu'."
					},
					"response": []
				},
				{
					"name": "Persetujuan Peminjaman (Ditolak)",
