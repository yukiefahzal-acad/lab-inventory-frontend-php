						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": 2,\n    \"status\": \"Ditolak\",\n    \"catatan_pinjaman\": \"Ditolak karena stok alat sedang dialokasikan untuk praktikum.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/peminjaman/persetujuan",
							"host": ["{{base_url}}"],
							"path": ["api", "peminjaman", "persetujuan"]
						},
						"description": "Menolak peminjaman. Stok alat akan dikembalikan otomatis. Membutuhkan role Admin."
					},
					"response": []
				}
			]
		},
